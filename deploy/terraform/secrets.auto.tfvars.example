# このファイルを secrets.auto.tfvars にコピーして値を記入します。secrets.auto.tfvars は git の管理外です。
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars

# ユーザー API トークンです。必要な権限は次のとおりです。
#   ゾーン - DNS                  - 編集     （okamyuji.work）
#   ゾーン - ゾーン               - 読み取り （okamyuji.work）
#   ゾーン - SSL and Certificates - 編集     （okamyuji.work）
#   ゾーン - Zone WAF             - 編集     （okamyuji.work）
cloudflare_api_token = "ここにAPIトークン"

# 同居先 EC2 の Elastic IP です。feedflow の deploy/terraform で terraform output -raw elastic_ip を実行して取得します。
origin_public_ip = "ここにEIP"
