# awase のサーバブロックです。feedflow の nginx が読む conf.d へ zz-awase.conf として置きます。
# 名前順で最後に読ませ、どのサーバー名にも一致しない要求の行き先（既定のサーバー）を変えません。
# real_ip_header は feedflow.conf が http コンテキストで宣言しているため、server の中にだけ書きます。

server {
    listen 80;
    listen [::]:80;
    server_name ${hostname};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${hostname};

    ssl_certificate     /etc/feedflow/tls/awase.crt;
    ssl_certificate_key /etc/feedflow/tls/awase.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

${real_ip_from_block}
    real_ip_header CF-Connecting-IP;

    # CSP などのヘッダはアプリが付けます。重ねると Referrer-Policy は後ろの値が使われ、CSP は両方が適用されるためです。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # awase-app は別の compose プロジェクトなので、Docker の内蔵 DNS で要求時に名前解決します。
    # 変数経由の proxy_pass にすると、awase-app が止まっていても nginx の起動と reload は成功し、awase だけが 502 になります。
    resolver 127.0.0.11 valid=30s;
    set $awase_upstream awase-app:8080;

    location / {
        proxy_pass http://$awase_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        # 利用者が送った X-Real-IP を必ず上書きします。awase はこの値でログイン失敗を数えます。
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
    }
}
